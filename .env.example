# ============================================
# COLLEGE DIGITAL PLATFORM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public Key) - Safe for client-side use
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side only) - NEVER expose to frontend
# This key bypasses RLS policies - use only in server-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# OpenAI API Key (for AI assistant and news agent)
OPENAI_API_KEY=your-openai-api-key-here

# AI Model Configuration
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# ============================================
# NOTIFICATION CONFIGURATION
# ============================================
# Email Service Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Web Push Configuration (optional)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=your-vapid-email

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Application Name
VITE_APP_NAME=MBSCET Digital Platform

# Application URL
VITE_APP_URL=http://localhost:5173

# Production URL (for production builds)
VITE_APP_PRODUCTION_URL=https://your-domain.com

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Session Timeout (in hours)
SESSION_TIMEOUT_HOURS=24

# Maximum File Upload Size (in MB)
MAX_FILE_SIZE_MB=10

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/Disable specific features
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_NEWS_AGENT=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_GALLERY=true

# ============================================
# DEVELOPMENT CONFIGURATION
# ============================================
# Development Mode
NODE_ENV=development

# Enable Debug Logging
VITE_DEBUG=true

# Mock Data (for development)
VITE_USE_MOCK_DATA=false